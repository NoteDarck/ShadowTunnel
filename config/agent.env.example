# Copy to /etc/shadowtunnel/agent.env and replace the placeholder.
# Never commit or publish the resulting file.
SHADOW_TOKEN=replace-with-a-long-random-secret
SHADOW_GATEWAY=127.0.0.1:9000
SHADOW_TUNNEL=default
SHADOW_MINECRAFT_TYPE=java
SHADOW_TRANSPORT=tcp
SHADOW_DESTINATION=127.0.0.1:25565
# SHADOW_TLS=1
# SHADOW_TLS_CA=/etc/shadowtunnel/gateway-ca.pem
# SHADOW_TLS_SERVER_NAME=gateway.example.com
