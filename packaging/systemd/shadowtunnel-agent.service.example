[Unit]
Description=ShadowTunnel agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadowtunnel
Group=shadowtunnel
WorkingDirectory=/etc/shadowtunnel
EnvironmentFile=/etc/shadowtunnel/agent.env
ExecStart=/usr/local/bin/shadowtunnel-agent
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shadowtunnel

[Install]
WantedBy=multi-user.target
